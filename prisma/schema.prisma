generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  service   String
  budget    String?
  message   String
  createdAt DateTime @default(now())
}